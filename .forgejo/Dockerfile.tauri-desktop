# syntax=docker/dockerfile:1
#
# Tauri Desktop CI image — builds .deb, .rpm, .AppImage for Linux
#
# Adds WebKitGTK and system dependencies required by Tauri on Linux.
#
# Build and push:
#   docker buildx build -t git.js-node.cc/jsprague/tauri-desktop-ci:latest -f .forgejo/Dockerfile.tauri-desktop .
#   docker login git.js-node.cc && docker push git.js-node.cc/jsprague/tauri-desktop-ci:latest

FROM git.js-node.cc/jsprague/svrctlrs-ci:latest

# Tauri Linux build dependencies (Debian Bookworm)
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    # WebKitGTK (Tauri WebView)
    libwebkit2gtk-4.1-dev \
    # GTK and GLib
    libgtk-3-dev \
    libglib2.0-dev \
    # Build essentials
    build-essential \
    pkg-config \
    libssl-dev \
    # Tauri optional deps
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libsoup-3.0-dev \
    # RPM packaging
    rpm \
    # AppImage tooling
    file \
    # Flatpak packaging
    flatpak \
    flatpak-builder \
    elfutils \
    && rm -rf /var/lib/apt/lists/*

# Install Flatpak runtime and SDK for building
RUN flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo \
    && flatpak install -y --noninteractive flathub \
       org.gnome.Platform//46 \
       org.gnome.Sdk//46

# Install Tauri CLI
RUN npm install -g @tauri-apps/cli

WORKDIR /workspace
