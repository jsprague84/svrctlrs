# SvrCtlRS — environment for docker-compose.yml (Traefik) or docker-compose.standalone.yml.
# Copy to .env, chmod 600, fill in the two required values. Everything the server reads is
# listed; see docs/DEPLOYMENT.md.

# ---- required -------------------------------------------------------------------------
# Password of the admin user created on the FIRST start only (when no users exist).
ADMIN_PASSWORD=change-me
# 64 hex characters for AES-256-GCM credential encryption: openssl rand -hex 32
# Back this up with the database; losing it makes stored credentials unrecoverable.
ENCRYPTION_KEY=

# ---- optional -------------------------------------------------------------------------
ADMIN_USERNAME=admin
# Image tag: latest, vX.Y.Z, or a short commit SHA (the deploy script writes one here).
TAG=latest
RUST_LOG=info
DATABASE_URL=sqlite:/app/data/svrctlrs.db
# Origins of the Tauri desktop/Android apps, comma-separated. Leave empty for browser-only
# use: setting it enables CORS for those origins and makes the session cookie SameSite=None.
# ALLOWED_ORIGINS=tauri://localhost,https://tauri.localhost,http://tauri.localhost
ALLOWED_ORIGINS=
# Host directory mounted read-only at /home/svrctlrs/.ssh for key-path credentials.
# Use a dedicated directory, not your own ~/.ssh.
SSH_KEY_PATH=./ssh
# Traefik host rule used by the reference compose labels.
SVRCTLRS_HOST=svrctlrs.js-node.app
# Standalone compose only: where the port is published. 127.0.0.1:8080 for a reverse proxy on
# this host; 8080 for every interface.
# SVRCTLRS_BIND=127.0.0.1:8080
# Standalone over plain HTTP on a trusted LAN only (the browser drops a Secure cookie on http).
# SESSION_SECURE=false
RESTART_POLICY=unless-stopped

# ---- sign-in with an OpenID Connect provider (optional; docs/DEPLOYMENT.md) -------------
# The address people open; the provider's callback is PUBLIC_URL/auth/oidc/callback.
# PUBLIC_URL=https://svrctlrs.example.com
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Pocket ID
# OIDC_ALLOWED_GROUPS=owner
# off: no password sign-in at all, the provider is the only way in (API tokens unaffected).
# docker-compose.yml (no login proxy in front) defaults to off and then needs the provider
# above; docker-compose.standalone.yml defaults to on. Set it to on here for break-glass.
# PASSWORD_LOGIN=on
